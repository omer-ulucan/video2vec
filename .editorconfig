root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.{json,md}]
indent_size = 2

# Markdown keeps each paragraph on one line, as the existing docs do: an edit
# never reflows neighbouring lines, and line length does not change the
# rendered text.
[*.md]
max_line_length = off

[CMakeLists.txt]
indent_size = 4

# License texts are kept verbatim, so their line lengths are not reflowed.
[{LICENSE-*,LICENSES/**}]
max_line_length = off

# deps.lock lines hold a full SHA-256 and URL each.
[deps.lock]
max_line_length = off
